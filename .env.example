# =============================================================================
# Qwen Token Gateway — environment configuration
# Copy to .env and fill in. NEVER commit a filled-in .env.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | production | test
APP_ENV=development
APP_NAME=Qwen Token Gateway
# Bind all interfaces: required for Docker/Railway/VPS. Do not use 127.0.0.1.
HOST=0.0.0.0
# Railway and most PaaS inject PORT automatically.
PORT=8787
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true emits one JSON object per log line (recommended in production).
LOG_JSON=false

# --- Secrets (REQUIRED in production) ----------------------------------------
# Encrypts stored Qwen credentials. Generate with:
#   python -m app.cli generate-key
# Changing this makes previously stored credentials undecryptable.
GATEWAY_SECRET_KEY=

# Admin dashboard login. The admin API/UI stays disabled until both are set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Admin session lifetime in seconds (default 12 hours).
SESSION_TTL_SECONDS=43200

# --- Database ----------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db
# PostgreSQL (plain postgres:// URLs are accepted and upgraded automatically):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/qwen_gateway
# Days of request history to keep (0 disables purging).
REQUEST_LOG_RETENTION_DAYS=14
# Store a redacted preview of request bodies (off by default; adds prompt data).
STORE_REQUEST_BODIES=false

# --- Provider ----------------------------------------------------------------
# qwen = real upstream; mock = offline provider for development/testing.
DEFAULT_PROVIDER=qwen
ENABLE_MOCK_PROVIDER=true

# Which Qwen dialect to use. auto detects per credential.
#   portal = OAuth bearer token against portal.qwen.ai
#   web    = chat.qwen.ai session cookie
QWEN_MODE=auto
QWEN_PORTAL_BASE_URL=https://portal.qwen.ai/v1
QWEN_WEB_BASE_URL=https://chat.qwen.ai
QWEN_REQUEST_TIMEOUT=120
QWEN_CONNECT_TIMEOUT=15
QWEN_MAX_RETRIES=2
QWEN_WEB_CLIENT_VERSION=0.2.81
# Used only for the standard OAuth refresh grant when you supply a refresh token.
QWEN_OAUTH_CLIENT_ID=f0304373b74a44d2b584a3fb70ca9e56
QWEN_OAUTH_BASE_URL=https://chat.qwen.ai
# Optional outbound proxy, e.g. http://user:pass@host:3128
# HTTP_PROXY_URL=

# --- Gateway behaviour -------------------------------------------------------
# round_robin | least_recently_used
SCHEDULER_STRATEGY=round_robin
# Seconds a credential rests after a generic failure.
DEFAULT_COOLDOWN_SECONDS=300
# Seconds a credential rests after HTTP 429 (upstream Retry-After wins).
RATE_LIMIT_COOLDOWN_SECONDS=900
# How many different credentials one request may try.
MAX_FAILOVER_ATTEMPTS=3
# Expose upstream reasoning as message.reasoning_content. Off by default.
EXPOSE_REASONING=false
# Max inbound request body in bytes (8 MiB default).
MAX_REQUEST_BYTES=8388608
STREAM_IDLE_TIMEOUT=180

# --- Models ------------------------------------------------------------------
DEFAULT_MODEL=qwen3-max
# alias=target pairs, comma separated.
MODEL_ALIASES=qwen=qwen3-max,qwen-default=qwen3-max,qwen-coder=qwen3-coder-plus,qwen-thinking=qwen3-max-thinking

# --- Security ----------------------------------------------------------------
# "*" or a comma-separated origin list. Use an explicit list in production.
CORS_ALLOW_ORIGINS=*
# Per-IP per-minute limits. 0 disables.
ADMIN_RATE_LIMIT_PER_MINUTE=120
PUBLIC_RATE_LIMIT_PER_MINUTE=0
# Enable only when running behind a trusted reverse proxy / load balancer.
TRUST_FORWARDED_FOR=false
