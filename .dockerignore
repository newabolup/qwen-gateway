# Version control / editors
.git
.gitignore
.idea
.vscode

# Python artefacts
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
*.egg-info/

# Node artefacts (the image builds the frontend itself)
frontend/node_modules/
frontend/dist/

# Local state and secrets — must never enter an image
.env
.env.*
!.env.example
data/
*.db
*.db-wal
*.db-shm
*.log

# Docs / tests not needed at runtime
tests/
docs/
*.md
!README.md
